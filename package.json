{
  "name": "fivem-devmanager",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "FiveM DevManager - plateforme centralisée de développement, gestion et supervision de serveur FiveM",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "prisma generate && node scripts/copy-monaco.mjs && next build",
    "start": "node server.mjs",
    "postinstall": "prisma generate && node scripts/copy-monaco.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:demo": "node prisma/seed-demo.mjs",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node scripts/api-smoke.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "verify": "node scripts/verify.mjs",
    "secret:generate": "node scripts/generate-secret.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "diff": "^7.0.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.9.1",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.52.2",
    "next": "^15.2.0",
    "otpauth": "^9.3.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.1",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.187.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ssh2": "^1.15.4",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.5.14",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
