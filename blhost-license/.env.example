# Adresse de ton install Keygate (sans slash final)
KEYGATE_URL=https://licences.bl-host.site

# Identifiant du produit (slug ou label produit utilise par Keygate)
BLHOST_PRODUCT=blhost-discord

# Cle de licence utilisee par le site / le bot
LICENSE_KEY=

# Cle Ed25519 publique de verification des tokens hors-ligne
# (recuperee sur GET /api/v1/license/pubkey) - optionnel
# KEYGATE_PUBKEY=

# --- Gate de blocage (gate.js) ----------------------------------------------
# Identifiant stable de l'activation (defaut : nom de machine).
# LICENSE_IDENTIFIER=
# true = bloquer meme sans cle configuree, false = gate coupe, absent = auto
# (bloque seulement si LICENSE_KEY est present)
# LICENSE_ENFORCE=true
# Tolerance hors-ligne apres expiration du token, en heures (defaut 72)
# LICENSE_GRACE_HOURS=72
# Periode de re-verification pendant l'execution, en minutes (defaut 60)
# LICENSE_CHECK_INTERVAL_MINUTES=60

# --- Bot Discord (bot-gate.example.js) --------------------------------------
# DISCORD_TOKEN=
