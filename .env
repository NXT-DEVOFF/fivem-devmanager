# ============================================================================
# FiveM DevManager - fichier .env public
# Ce fichier ne contient aucun mot de passe, token ou cle secrete.
# Ne pas y ajouter de valeurs reelles : utiliser un .env local non versionne.
# ============================================================================

# --- Application -------------------------------------------------------------
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Base de donnees (MariaDB / MySQL) --------------------------------------
# Renseigner localement l'URL MySQL/MariaDB fournie par l'hebergeur.
DATABASE_URL=

# --- Docker Compose (optionnel) ---------------------------------------------
MARIADB_USER=fivem
MARIADB_PASSWORD=
MARIADB_DATABASE=fivem_devmanager
MARIADB_ROOT_PASSWORD=

# --- Securite ---------------------------------------------------------------
APP_ENCRYPTION_KEY=
APP_SECRET=
AUTH_SESSION_DAYS=30

# --- Compte super administrateur initial (seed uniquement) ------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Super Admin"

# --- Limites de securite ----------------------------------------------------
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
MAX_FILE_SIZE_KB=2048
MAX_ATTACHMENT_SIZE_KB=8192
ATTACHMENT_DIR=var/attachments

# --- Sauvegardes / snapshots ------------------------------------------------
SNAPSHOT_DIR=var/snapshots

# --- Realtime ---------------------------------------------------------------
FILE_SYNC_INTERVAL_SECONDS=180

# --- IA (optionnel) ---------------------------------------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# --- Anticheat --------------------------------------------------------------
ANTICHEAT_INGEST_TOKEN=

# --- Mentions legales -------------------------------------------------------
LEGAL_DRAFT=true
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_STATUS=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_PHONE=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_PUBLISHER_CAPITAL=
LEGAL_PUBLISHER_SIREN=
LEGAL_PUBLISHER_VAT=

# --- Divers -----------------------------------------------------------------
DEMO_MODE=false
